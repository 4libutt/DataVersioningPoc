<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\DataVersioningPoc.Analyzer\DataVersioningPoc.Analyzer.csproj"
						  OutputItemType="Analyzer"
						  ReferenceOutputAssembly="false" />

		<ProjectReference Include="..\DataVersioningPoc.Shared\DataVersioningPoc.Shared.csproj" />

		<ProjectReference Include="..\DataVersioningPoc.Generator\DataVersioningPoc.Generator.csproj"
						  ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="..\DataVersioningPoc.Analyzer\Baseline\model-baseline.json" />
	</ItemGroup>

	<Target Name="GenerateDataStructureBaseline"
        AfterTargets="Build"
        Condition="'$(DesignTimeBuild)' != 'true'">

		<Exec
			Command="dotnet &quot;$(MSBuildThisFileDirectory)..\DataVersioningPoc.Generator\bin\$(Configuration)\net10.0\DataVersioningPoc.Generator.dll&quot; &quot;$(TargetPath)&quot; &quot;$(MSBuildThisFileDirectory)..\DataVersioningPoc.Analyzer\Baseline\model-baseline.json&quot;" />

		<Message
			Importance="high"
			Text="Data structure baseline checked and updated when necessary." />

	</Target>

</Project>